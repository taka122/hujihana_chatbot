APP_DOMAIN=chat.example.com
FILES_DOMAIN=files.chat.example.com
LETSENCRYPT_EMAIL=ops@example.com

POSTGRES_DB=rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-db-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
S3_BUCKET=rag-documents
S3_PUBLIC_ENDPOINT=https://files.chat.example.com

CORS_ORIGINS=https://chat.example.com
CLINIC_PASSWORD=change-this-shared-password
GEMINI_API_KEY=replace-with-your-key

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
PDF_OCR_ENABLED=true
PDF_OCR_MODEL=gemini-2.0-flash
PDF_OCR_MAX_PAGES_PER_DOC=20

# Optional: Drive import feature
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=/run/secrets/google-drive-service-account.json
