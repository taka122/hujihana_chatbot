# ----- Database -----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- MinIO / S3 -----
# S3_ENDPOINT        : バックエンド→MinIO 接続URL
#   docker compose 使用時: http://minio:9000
#   直接起動（python）時 : http://localhost:9000
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT : ブラウザが presigned URL でアクセスするURL
#   ★ PDFを開けないエラーが出る場合は、ブラウザから届くIPに変更してください
#   例) 同じPC            : http://localhost:9000
#   例) LAN内の別端末から : http://192.168.x.x:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-documents
S3_REGION=us-east-1
S3_PRESIGN_EXPIRE_SEC=3600

# ----- Gemini -----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ----- Embedding -----
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

# ----- LLM -----
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# ----- PDF OCR -----
# Gemini Vision APIを呼ぶため、ページ数が多いほどコストが上がります。
PDF_OCR_ENABLED=true
PDF_OCR_MODEL=gemini-2.5-flash
PDF_OCR_MAX_PAGES_PER_DOC=20

# ----- Retrieval -----
VECTOR_TOP_K=10
KEYWORD_TOP_K=10
ANSWER_CONTEXT_CHUNKS=5
ANSWER_CONTEXT_TEXT_MAX_CHARS=1000
LLM_RETRY_ATTEMPTS=2
RETRIEVAL_SCORE_THRESHOLD=0.25

# ----- Chunking -----
CHUNK_SIZE_CHARS=4200
CHUNK_OVERLAP_CHARS=500

# ----- CORS -----
# LAN内の別端末からアクセスする場合はそのIPも追加してください
# 例) CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.x.x:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
